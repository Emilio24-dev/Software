<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- fondo amarillo tipo CCTV -->
    <solid android:color="#FFD93B" />

    <!-- bordes redondeados pill -->
    <corners android:radius="8dp" />

    <!-- padding interno visual (opcional si querés que el badge se vea más gordito) -->
    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp" />
</shape>
