<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo lavanda reutilizable para las filas de Configuración (Idioma, Soporte, etc.) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Color de fondo lavanda -->
    <solid android:color="@color/settings_button_bg" />

    <!-- Borde sutil gris semitransparente -->
    <stroke
        android:width="1dp"
        android:color="@color/settings_button_stroke" />

    <!-- Bordes ligeramente redondeados -->
    <corners android:radius="4dp" />

    <!-- Margen interior pequeño -->
    <padding
        android:left="4dp"
        android:top="2dp"
        android:right="4dp"
        android:bottom="2dp" />
</shape>
