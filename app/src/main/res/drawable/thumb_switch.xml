<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ON -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp"/>
            <solid android:color="@color/switch_on_green"/>
            <stroke android:width="2dp" android:color="@color/switch_on_green_dark"/>
        </shape>
    </item>

    <!-- OFF -->
    <item>
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp"/>
            <solid android:color="@color/switch_off_red"/>
            <stroke android:width="2dp" android:color="@color/switch_off_red_dark"/>
        </shape>
    </item>
</selector>
