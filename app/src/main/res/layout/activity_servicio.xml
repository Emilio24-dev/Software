<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#182430"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvBackAyuda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&lt; Soporte"
        android:textSize="16sp"
        android:textColor="#31B7FF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Servicio de ayuda"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnContactanos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Contáctanos"
        android:background="@drawable/boton_blanco_cuadrado"
        app:backgroundTint="@null"
        android:textColor="#000000" />

</LinearLayout>