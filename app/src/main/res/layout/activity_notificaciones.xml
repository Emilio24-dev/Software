<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_bg"
    android:padding="16dp">

    <!-- Volver a Configuración -->
    <TextView
        android:id="@+id/tvBackNotif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_back"
        android:textColor="#00B7FF"
        android:textSize="18sp"
        android:fontFamily="serif"
        android:clickable="true"
        android:focusable="true" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitleNotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notifications"
        android:textColor="@color/settings_title_text"
        android:textStyle="italic"
        android:textSize="26sp"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:fontFamily="serif" />

    <!-- Fila: Alertas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/Alerts_noti"
            android:textSize="18sp"
            android:textColor="@color/settings_button_text"
            android:fontFamily="serif"
            android:background="@color/settings_button_bg"
            android:padding="10dp" />

        <!-- Switch corregido -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAlertas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/thumb_switch"
            android:track="@drawable/capsula_switch"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Fila: Notificaciones Push -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/Push"
            android:textSize="18sp"
            android:textColor="@color/settings_button_text"
            android:fontFamily="serif"
            android:background="@color/settings_button_bg"
            android:padding="10dp" />

        <!-- Switch corregido -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swPush"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/thumb_switch"
            android:track="@drawable/capsula_switch"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>