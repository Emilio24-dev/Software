<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg">

    <!-- Volver -->
    <TextView
        android:id="@+id/tvBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹ Configuracion"
        android:textColor="#00B7FF"
        android:textSize="18sp"
        android:fontFamily="serif"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <!-- Título -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Idioma"
        android:textStyle="italic"
        android:textSize="28sp"
        android:textColor="@color/settings_title_text"
        android:fontFamily="serif"
        app:layout_constraintTop_toBottomOf="@id/tvBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Subtítulo -->

    <!-- Lista -->
    <TextView
        android:id="@+id/tvSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="136dp"
        android:layout_marginTop="28dp"
        android:fontFamily="serif"
        android:text="Lista de idiomas"
        android:textColor="@color/settings_title_text"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <LinearLayout
        android:id="@+id/listContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Español -->
        <LinearLayout
            android:id="@+id/rowEs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/idioma_rectangulo">

            <TextView
                android:id="@+id/tvEs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Español(El Salvador)"
                android:textColor="@color/settings_button_text"
                android:textSize="18sp"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/checkEs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_button_stroke"/>

        <!-- Inglés -->
        <LinearLayout
            android:id="@+id/rowEn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/idioma_rectangulo"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvEn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="Ingles(Estados Unidos)"
                android:textColor="@color/settings_button_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/checkEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/purple_500"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Puntos decorativos -->
</androidx.constraintlayout.widget.ConstraintLayout>
